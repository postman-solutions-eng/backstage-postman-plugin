          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response time is below 2000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(2000);\n});\n\npm.test(\"Response has a JSON body\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"Response body contains a url field equal to https://postman-echo.com/get\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.url).to.eql(\"https://postman-echo.com/get\");\n});\n\npm.test(\"Response body contains a headers object\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.headers).to.be.an(\"object\");\n});"
            ]
          },
          "disabled": false
        }
      ],
      "id": "868a0b81-6171-4afd-a542-7909fd6e0e1d",
